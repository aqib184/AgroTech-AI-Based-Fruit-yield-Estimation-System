# Copy to ".env" in this folder (same level as app.config.ts). Expo loads EXPO_PUBLIC_* at build time.

# Django API (no trailing slash). Examples:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Android emulator hitting host machine: http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# OpenWeatherMap (https://openweathermap.org/api). Current + 5-day/3-hour forecast.
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key

# Optional override (defaults to OpenWeather 2.5 base URL)
# EXPO_PUBLIC_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
